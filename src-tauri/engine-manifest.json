{
  "schemaVersion": 1,
  "product": "LocalConvert Desktop",
  "platformMatrix": {
    "desktopFullEdition": [
      "windows-x86_64",
      "windows-aarch64",
      "macos-aarch64",
      "macos-x86_64",
      "linux-x86_64"
    ],
    "mobileLiteEditionFutureOnly": [
      "android-aarch64",
      "ios-aarch64"
    ]
  },
  "v1EnabledPlatforms": [
    "windows-x86_64",
    "macos-aarch64"
  ],
  "futurePlatforms": [
    "windows-aarch64",
    "macos-x86_64",
    "linux-x86_64",
    "android-aarch64",
    "ios-aarch64"
  ],
  "buildVerification": {
    "requiredBundledAssets": {
      "macos-aarch64": [
        {
          "name": "qpdf",
          "type": "sidecar",
          "requiredLicenseFiles": [
            "src-tauri/resources/licenses/qpdf-12.3.2-LICENSE.txt",
            "src-tauri/resources/licenses/qpdf-12.3.2-NOTICE.md",
            "src-tauri/resources/licenses/qpdf-macos-aarch64-BUILD-NOTICE.txt"
          ]
        },
        {
          "name": "image-engine",
          "type": "sidecar",
          "requiredLicenseFiles": [
            "src-tauri/resources/licenses/image-engine-macos-aarch64-BUILD-NOTICE.txt",
            "src-tauri/resources/licenses/webpx-0.4.0-LICENSE-MIT.txt",
            "src-tauri/resources/licenses/libwebp-1.6.0-COPYING.txt",
            "src-tauri/resources/licenses/libwebp-1.6.0-PATENTS.txt"
          ]
        }
      ]
    },
    "plannedOnlyEngines": [
      "libreoffice",
      "pdfium"
    ]
  },
  "rules": {
    "fullBundledEngineEdition": "desktop-only",
    "mobileOfficeConversion": "Do not promise LibreOffice-based Office conversion on Android or iOS.",
    "sidecarDestination": "src-tauri/binaries/<platform>/",
    "runtimeDestination": "src-tauri/resources/engines/<engine>/<platform>/",
    "fontsDestination": "src-tauri/resources/fonts/",
    "licensesDestination": "src-tauri/resources/licenses/",
    "frontendExecution": "Frontend calls Rust backend commands only.",
    "backendExecution": "Rust backend commands spawn sidecars using argument arrays.",
    "shellPolicy": "Do not use shell=true and do not concatenate shell command strings."
  },
  "requiredEngines": [
    {
      "name": "libreoffice",
      "displayName": "LibreOffice headless",
      "desktopOnly": true,
      "responsibility": "Office-to-PDF conversion.",
      "requiredAssetTypes": [
        "sidecar",
        "runtime-folder"
      ]
    },
    {
      "name": "qpdf",
      "displayName": "qpdf",
      "desktopOnly": true,
      "responsibility": "PDF merge, split, extraction, and rotation.",
      "requiredAssetTypes": [
        "sidecar"
      ]
    },
    {
      "name": "pdfium",
      "displayName": "PDFium",
      "desktopOnly": true,
      "responsibility": "PDF rasterization and preview.",
      "requiredAssetTypes": [
        "library"
      ]
    },
    {
      "name": "image-engine",
      "displayName": "image-engine",
      "desktopOnly": true,
      "responsibility": "Image conversion, compression, resizing, and best-effort metadata/privacy cleanup.",
      "requiredAssetTypes": [
        "sidecar"
      ]
    }
  ],
  "assetRecordRequiredFields": [
    "name",
    "version",
    "platform",
    "type",
    "source",
    "sha256",
    "license",
    "destination"
  ],
  "allowedAssetTypes": [
    "sidecar",
    "runtime-folder",
    "library",
    "font",
    "license"
  ],
  "assets": [
    {
      "name": "qpdf",
      "version": "12.3.2",
      "platform": "macos-aarch64",
      "type": "sidecar",
      "source": "https://github.com/qpdf/qpdf/releases/download/v12.3.2/qpdf-12.3.2.tar.gz",
      "sha256": "4d32d1ea36dfaec46ea1dda4d57bd4ffe2c2af8c6f9268167d313bbdfa98a790",
      "license": "Apache-2.0; see src-tauri/resources/licenses/qpdf-12.3.2-LICENSE.txt, src-tauri/resources/licenses/qpdf-12.3.2-NOTICE.md, and src-tauri/resources/licenses/qpdf-macos-aarch64-BUILD-NOTICE.txt",
      "destination": "src-tauri/binaries/macos-aarch64/qpdf"
    },
    {
      "name": "image-engine",
      "version": "0.5.0-preview.0",
      "platform": "macos-aarch64",
      "type": "sidecar",
      "source": "first-party Rust source: src-tauri/src/bin/image-engine.rs; pinned image crate 0.25.10 codecs; webpx 0.4.0 with statically linked libwebp 1.6.0",
      "sha256": "fbeb095b354d678344987a3c349111614aeb500082ba1a4e6f2e2a00283bf7a8",
      "license": "First-party LocalConvert Desktop sidecar with third-party Rust codec dependencies; see src-tauri/resources/licenses/image-engine-macos-aarch64-BUILD-NOTICE.txt, src-tauri/resources/licenses/webpx-0.4.0-LICENSE-MIT.txt, src-tauri/resources/licenses/libwebp-1.6.0-COPYING.txt, and src-tauri/resources/licenses/libwebp-1.6.0-PATENTS.txt",
      "destination": "src-tauri/binaries/macos-aarch64/image-engine"
    }
  ]
}
