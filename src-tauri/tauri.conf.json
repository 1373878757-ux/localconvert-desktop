{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LocalConvert Desktop",
  "version": "0.2.0",
  "identifier": "com.localconvert.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBundleCommand": "node src-tauri/scripts/verify-engines.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "LocalConvert Desktop",
        "width": 1120,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "LocalConvert Desktop",
        "width": 420,
        "height": 250,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "engine-manifest.json": "engine-manifest.json",
      "resources/licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/macos-aarch64/qpdf",
      "binaries/macos-aarch64/image-engine"
    ]
  }
}
